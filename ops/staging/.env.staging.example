# Staging API (Creem TEST mode). Copy to /www/wwwroot/staging-api/.env and
# fill in the blanks on the server. Never commit the filled-in copy, and
# never reuse a production key, secret, database or bucket here.

APP_NAME="creatif.space (staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-api.creatif.space
FRONTEND_URL=https://staging-app.creatif.space
PUBLIC_URL=https://staging-app.creatif.space
MARKETING_URL=https://staging-app.creatif.space
# Every response says X-Robots-Tag: noindex, nofollow.
APP_NOINDEX=true

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Our own reverse proxy, if any (IPs/CIDRs). Cloudflare is recognised on its own.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
WEBHOOK_LOG_LEVEL=info

# A database of its own: never the production one.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=creatif_staging
DB_USERNAME=creatif_staging
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.creatif.space
# Its own cookie name, so a staging sign-in never overwrites production's.
SESSION_COOKIE=creatif_staging_session
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=staging-app.creatif.space
QUEUE_CONNECTION=database
CACHE_STORE=database
# Keeps staging's cache keys apart if it ever shares a cache with anything.
CACHE_PREFIX=staging_
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Nothing leaves the server: mail is written to storage/logs.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@creatif.space"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
RESEND_WAITLIST_MCP_SEGMENT=

# Storage: a staging bucket and its own keys, or leave empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=creatif-space-staging
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Google sign-in: a staging OAuth client (redirect below), or leave empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging-api.creatif.space/auth/google/callback
GOOGLE_NATIVE_EXTRA_AUDIENCES=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SA_EMAIL=

# Creem TEST mode: test API key, test webhook secret and test product ids
# from the Creem dashboard (test mode). Live ids do not work here.
CREEM_TEST_MODE=true
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_PRO_MONTHLY=
CREEM_PRODUCT_PRO_YEARLY=
CREEM_PRODUCT_MAX_MONTHLY=
CREEM_PRODUCT_MAX_YEARLY=
CREEM_PRODUCT_CREDITS=
# Product ids existing subscriptions still renew on ("prod_a=pro_monthly,…").
CREEM_LEGACY_PRODUCTS=
CREEM_FOUNDING_CODE=

# Social posting: empty = nothing is ever posted from staging.
SOCIAL_PROVIDER=outstand
OUTSTAND_API_KEY=
OUTSTAND_BASE_URL=https://api.outstand.so/v1
OUTSTAND_WEBHOOK_SECRET=
POSTFORME_API_KEY=
POSTFORME_BASE_URL=
POSTFORME_WEBHOOK_SECRET=

# Caption help (OpenAI-compatible): empty = off.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Analytics: empty = off (staging never reports to production analytics).
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
ANALYTICS_INTERNAL_EMAIL_DOMAINS=
ANALYTICS_INTERNAL_EMAILS=

# MCP / OAuth. `php artisan passport:keys` writes the key pair to storage/
# (the deploy script does it once). Introspect secret: openssl rand -hex 32,
# the same value in the staging MCP server's mcp/.env.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
MCP_RESOURCE_URL=https://staging-mcp.creatif.space/mcp
MCP_INTROSPECT_SECRET=
MCP_REGISTRATION_ENABLED=true

# Ops: alerts go nowhere until set; health/deep is 404 without a token.
OPS_ALERT_EMAIL=
HEALTH_TOKEN=
HEALTH_QUEUE_MAX_LAG=600
