# /etc/cs-deploy.env — settings for ops/autodeploy/cs-deploy.sh. NO SECRETS: git reads the private repos
# through root's existing deploy keys (ssh aliases gh-app / gh-mkt); the API repo is public.
# Plain KEY=value lines (sourced by bash).

# Order matters: the API (and MCP) go first, then the app, then marketing.
SITES="api app mkt"

# --- API + MCP (creatif.space-api) ----------------------------------------------------------------------
API_URL=https://github.com/creatifren/creatif.space-api.git
# The same scripts used by hand in aaPanel. They must run in the FOREGROUND (no nohup/&/disown inside).
API_DEPLOY_CMD="bash /root/deploy-api.sh && bash /root/deploy-csmcp.sh"
API_SMOKE="https://api.creatif.space/up=200 https://api.creatif.space/api/v1/plans=200 https://api.creatif.space/api/v1/inbox/summary=401 https://mcp.creatif.space/health=200"
# A head that changes these paths is held unless its commit message carries [migrate-ok] (Rizal's yes).
API_MIGRATION_PATHS="database/migrations"
# No automatic rollback for the API (database). Rollback = git revert on main -> the timer redeploys.
API_ROLLBACK_CMD=""

# --- App (creatif.space -> app.creatif.space) -------------------------------------------------------------
APP_URL=git@gh-app:creatifren/creatif.space.git
APP_DEPLOY_CMD="bash /root/d-site.sh app"
APP_SMOKE="https://app.creatif.space/login=200 https://app.creatif.space/post=200"
# Blue/green keeps the previous colour: set this once the server's bluegreen.sh interface is confirmed, e.g.
# APP_ROLLBACK_CMD="bash /opt/creatif-ops/bluegreen.sh app --to <previous colour> --no-build"
APP_ROLLBACK_CMD=""

# --- Marketing (creatifspace -> creatif.space) ------------------------------------------------------------
MKT_URL=git@gh-mkt:creatifren/creatifspace.git
MKT_DEPLOY_CMD="bash /root/d-site.sh mkt"
MKT_SMOKE="https://creatif.space/=200 https://creatif.space/pricing=200"
MKT_ROLLBACK_CMD=""

# --- General ----------------------------------------------------------------------------------------------
# Extra env for the deploy commands (they run under env -i).
EXTRA_ENV="pnpm_config_registry=https://registry.npmjs.org/"
DEPLOY_TIMEOUT=1500
STATUS_FILE=/var/lib/cs-deploy/status.json
# DRY_RUN=1 logs what would deploy and changes nothing.
DRY_RUN=0
