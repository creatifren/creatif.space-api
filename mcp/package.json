{
  "name": "@creatif/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "creatif.space remote MCP server — a thin layer over the V1 API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
