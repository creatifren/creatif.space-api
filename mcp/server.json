{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.creatifren/creatif-space",
  "title": "Creatif Space",
  "description": "Get content approved & published faster: draft, get client approval, publish from Claude or ChatGPT.",
  "version": "1.2.2",
  "websiteUrl": "https://creatif.space/mcp",
  "repository": {
    "url": "https://github.com/creatifren/creatif.space-api",
    "source": "github",
    "subfolder": "mcp"
  },
  "icons": [
    {
      "src": "https://creatif.space/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.creatif.space/mcp"
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "server_version": "0.3.0",
      "auth": {
        "type": "oauth2",
        "authorization_server": "https://api.creatif.space",
        "protected_resource_metadata": "https://mcp.creatif.space/.well-known/oauth-protected-resource/mcp",
        "scopes": [
          "read",
          "draft",
          "approve",
          "publish",
          "approvals:decide"
        ],
        "api_keys": "Personal API keys (cs_live_…) from creatif.space → Settings → API keys also work as the Bearer token."
      },
      "tools": [
        "check_approval_status",
        "confirm_media_upload",
        "create_approval_link",
        "create_content_plan",
        "create_insight_share_link",
        "create_space_from_files",
        "decide_approval",
        "discard_draft",
        "draft_post",
        "get_account_summary",
        "get_approval_audit",
        "get_approval_history",
        "get_best_times",
        "get_connect_link",
        "get_credits",
        "get_insight_csv_link",
        "get_insight_report_link",
        "get_insight_summary",
        "get_notification_settings",
        "get_onboarding",
        "get_plan_calendar_link",
        "get_post",
        "get_storage_usage",
        "keep_file",
        "list_approval_links",
        "list_channels",
        "list_conversations",
        "list_failed_posts",
        "list_files",
        "list_posts",
        "list_shared_with_me",
        "list_spaces",
        "list_top_posts",
        "list_waiting_approvals",
        "publish_post",
        "publish_space",
        "reply_to_conversation",
        "request_media_upload",
        "retry_post",
        "revoke_approval_link",
        "revoke_insight_share_link",
        "schedule_post",
        "schedule_posts",
        "send_approval_reminder",
        "send_feedback",
        "suggest_caption",
        "unkeep_file",
        "update_notification_settings",
        "update_post"
      ],
      "prompts": [
        "monthly_report",
        "plan_week",
        "send_for_approval",
        "weekly_results"
      ]
    }
  }
}
