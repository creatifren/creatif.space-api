{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.creatifren/creatif-space-tools",
  "title": "Creatif Space Free Tools",
  "description": "Free caption checks, client approval templates and connect guides for social media managers.",
  "version": "1.1.0",
  "websiteUrl": "https://creatif.space/",
  "repository": {
    "url": "https://github.com/creatifren/creatif.space-api",
    "source": "github",
    "subfolder": "mcp"
  },
  "icons": [
    {
      "src": "https://creatif.space/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.creatif.space/free"
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "auth": {
        "type": "none",
        "note": "No sign-in. 30 calls a minute per IP; nothing about the caller is stored."
      },
      "tools": [
        "approval_request_template",
        "check_caption",
        "connect_guide"
      ]
    }
  }
}
