APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Every customer is in Indonesia, and Analytics groups traffic by local hour
# while printing this zone in its own caption. On UTC the chart is seven
# hours out and labels itself correctly at the same time.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email is per-event, never a digest, and every type can be switched off
# in Settings — so deliverability matters more than volume here.
#
# `log` writes to storage/logs instead of sending: right for local work,
# and the reason nothing has ever left this machine. Switch to `resend`
# once RESEND_API_KEY is filled in and the domain's DNS is verified.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@creatif.space"
MAIL_FROM_NAME="${APP_NAME}"

# Resend. The sending domain needs SPF + DKIM records before anything
# reaches an inbox — until it is verified, Resend refuses the send rather
# than letting it land in spam.
RESEND_API_KEY=

# Only used when MAIL_MAILER=smtp.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Cloudflare R2 (S3-compatible) — primary asset storage. AWS_ENDPOINT is the
# account's S3 API endpoint; AWS_URL is the public serving domain (r2.dev in
# dev, custom domain in production).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=creatif-space
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Google OAuth — three passes: creator login, Drive connect (drive.file),
# and the client signing in to approve (identity only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/auth/google/drive/callback
GOOGLE_APPROVER_REDIRECT_URI=http://localhost:8000/auth/google/client/callback

# Midtrans — subscription checkout (Snap) + webhook. The server key doubles
# as the webhook signature secret.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Post for Me — social posting relay. The webhook secret comes back from
# registering the webhook (POST /v1/webhooks) and authenticates their calls.
POSTFORME_API_KEY=
POSTFORME_BASE_URL=
POSTFORME_WEBHOOK_SECRET=
