APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# The app (OAuth redirects, CORS) and where client links live. Prod:
# FRONTEND_URL=https://app.creatif.space, PUBLIC_URL=https://creatif.space
FRONTEND_URL=http://localhost:3000
# PUBLIC_URL=https://creatif.space

# Every customer is in Indonesia, and Analytics groups traffic by local hour
# while printing this zone in its own caption. On UTC the chart is seven
# hours out and labels itself correctly at the same time.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email is per-event, never a digest, and every type can be switched off
# in Settings — so deliverability matters more than volume here.
#
# `log` writes to storage/logs instead of sending: right for local work,
# and the reason nothing has ever left this machine. Switch to `resend`
# once RESEND_API_KEY is filled in and the domain's DNS is verified.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@creatif.space"
MAIL_FROM_NAME="${APP_NAME}"

# Resend. The sending domain needs SPF + DKIM records before anything
# reaches an inbox — until it is verified, Resend refuses the send rather
# than letting it land in spam.
RESEND_API_KEY=

# Only used when MAIL_MAILER=smtp.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Cloudflare R2 (S3-compatible) — primary asset storage. AWS_ENDPOINT is the
# account's S3 API endpoint; AWS_URL is the public serving domain (r2.dev in
# dev, custom domain in production).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=creatif-space
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Google OAuth — creator login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Creem — USD subscription checkout, Credits and signed webhooks.
# Test keys/products only work with test mode; live IDs are separate.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
CREEM_PRODUCT_PRO_MONTHLY=
CREEM_PRODUCT_PRO_YEARLY=
CREEM_PRODUCT_MAX_MONTHLY=
CREEM_PRODUCT_MAX_YEARLY=
CREEM_PRODUCT_CREDITS=
# The Pro products above carry Creem's 7-day trial. These are Pro without a
# trial, for owners who already had one or a paid plan; empty = a repeat
# trial is possible (logged as billing.repeat_trial_possible).
CREEM_PRODUCT_PRO_MONTHLY_NOTRIAL=
CREEM_PRODUCT_PRO_YEARLY_NOTRIAL=
# Founding 100: discount code sent on yearly checkouts; empty = off.
CREEM_FOUNDING_CODE=

# Social posting relay for new accounts and posts: outstand | postforme.
SOCIAL_PROVIDER=outstand

# Credits for one publish (one post to one account). X is priced on its
# own because X's API is pay-per-use: more when the caption has a link.
CREDITS_PER_SEND=300
CREDITS_PER_SEND_X=300
CREDITS_PER_SEND_X_LINK=2000

# Outstand — API key from outstand.so/app (Settings → API keys). The
# webhook secret is the Signing Secret you set on the webhook in Settings →
# Webhooks; it signs X-Outstand-Signature.
OUTSTAND_API_KEY=
OUTSTAND_BASE_URL=https://api.outstand.so/v1
OUTSTAND_WEBHOOK_SECRET=

# Post for Me — social posting relay. The webhook secret comes back from
# registering the webhook (POST /v1/webhooks) and authenticates their calls.
POSTFORME_API_KEY=
POSTFORME_BASE_URL=
POSTFORME_WEBHOOK_SECRET=

# Caption help in the composer — any OpenAI-compatible endpoint, e.g.
# AI_BASE_URL=https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Server-side product analytics (PostHog). Leave the key empty to turn it off.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Commit sent with $exception reports (else read from .git/HEAD)
APP_RELEASE=
# Comma lists: accounts matching either are sent with is_internal = true.
ANALYTICS_INTERNAL_EMAIL_DOMAINS=
ANALYTICS_INTERNAL_EMAILS=

# MCP — OAuth 2.1 (Laravel Passport) and personal API keys for MCP clients
# (Claude, ChatGPT, Claude Desktop/Code, Cursor). See config/mcp.php.
# Passport's RSA pair: `php artisan passport:keys` writes storage/oauth-*.key
# (git-ignored), or set the PEMs here (\n-escaped is fine).
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
# The Node MCP server: the protected resource the metadata advertises.
MCP_RESOURCE_URL=https://mcp.creatif.space/mcp
# Shared with the MCP server; it sends it as X-MCP-Secret to
# POST /api/v1/oauth/introspect. Empty = introspection refuses everyone.
# Generate: openssl rand -hex 32
MCP_INTROSPECT_SECRET=
MCP_ACCESS_TOKEN_TTL_MINUTES=60
MCP_REFRESH_TOKEN_TTL_DAYS=30
MCP_RATE_LIMIT_PER_MINUTE=120
# Dynamic Client Registration (POST /oauth/register). false = closed.
MCP_REGISTRATION_ENABLED=true

# Resend segment for confirmed MCP waitlist sign-ups (empty: confirm works, logs a warning)
RESEND_WAITLIST_MCP_SEGMENT=
